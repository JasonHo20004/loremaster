{
  "name": "@loremaster/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node ../../scripts/clean.mjs",
    "pretest": "corepack pnpm --filter @loremaster/config --filter @loremaster/contracts build",
    "pretypecheck": "corepack pnpm --filter @loremaster/config --filter @loremaster/contracts build",
    "test": "vitest run --root ../.. tests/api",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loremaster/config": "workspace:*",
    "@loremaster/contracts": "workspace:*",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.2"
  }
}
