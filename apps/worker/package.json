{
  "name": "@loremaster/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node ../../scripts/clean.mjs",
    "pretypecheck": "corepack pnpm --filter @loremaster/cache --filter @loremaster/config --filter @loremaster/database... --filter @loremaster/observability --filter @loremaster/queue build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@loremaster/cache": "workspace:*",
    "@loremaster/config": "workspace:*",
    "@loremaster/database": "workspace:*",
    "@loremaster/observability": "workspace:*",
    "@loremaster/queue": "workspace:*"
  }
}
